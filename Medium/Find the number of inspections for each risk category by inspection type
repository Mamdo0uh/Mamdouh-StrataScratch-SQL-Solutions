select inspection_type,
  sum(case when max_risk = 0 then 1 else 0 end) as no_risk_results,
  sum(case when max_risk = 1 then 1 else 0 end) as low_risk_results,
  sum(case when max_risk = 2 then 1 else 0 end) as medium_risk_results,
  sum(case when max_risk = 3 then 1 else 0 end) as high_risk_results,
  count(*) as total_inspections
from (
  select 
    inspection_id, 
    inspection_type,
    max(case 
      when risk_category = 'High Risk' then 3
      when risk_category = 'Moderate Risk' then 2
      when risk_category = 'Low Risk' then 1
      else 0 
    end) as max_risk
  from sf_restaurant_health_violations
  group by inspection_id, inspection_type
) as prioritized_inspections
group by inspection_type
order by total_inspections desc;
